# Mock dev mode — no OIDC server required.
# Run with: npm run dev:mock  (or rushx dev:mock)
#
# Auth is bypassed and mock users from public/app-config.json are used.
# Env vars here override the corresponding fields in app-config.json.

VITE_DEV_MODE=true
VITE_AUTH_ENABLED=true
VITE_FILE_AUTH_ENABLED=true

# HMAC secret used to sign locally-issued JWTs. Must match AUTH_JWT_SECRET_KEY on platform-api.
VITE_FILE_AUTH_JWT_SECRET=long-random-secret-here

# Org details — must match a seeded org in the local platform-api database
VITE_DEV_ORG_ID=db278eb4-9e08-4a6e-a00a-493d0ce4b8a6
VITE_DEV_ORG_NAME=Local Dev Org
VITE_DEV_ORG_HANDLE=local-dev-org

# Local platform API (via Vite proxy at /api-proxy → https://localhost:9243)
VITE_PLATFORM_API_BASE_URL=https://localhost:3009/api-proxy/api/v1
